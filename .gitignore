# Dependencias
node_modules/

# Salidas de render (el workflow las genera en cada ejecución)
renders/
snapshots/
exports/
dist/

# Artefactos locales de HyperFrames
.hyperframes/
capture/
capture-*/

# Sistema
.DS_Store
Thumbs.db

# Secretos: nunca subas claves al repositorio
.env
.env.*
!.env.example

# Ruta vieja de ffmpeg (abandonada). Los clips finales ya estan en
# assets/video, asi que esto es solo scratch local: benchmarks, QC y
# los clips originales. No tiene por que viajar al repositorio.
casa-modular/

# QC de snapshots locales (proyecto recortado para inspeccionar frames)
snapqc/

# clips candidatos de stock (descarga temporal, no se versionan)
assets/clips/candidates/

# material NUEVO del reel: en el repo solo vive el manifiesto (fuentes.json).
# Los clips y la musica se descargan y se montan en la nube (demo2/preparar-nuevo.mjs).
assets/nuevo/procesado/
assets/nuevo/*.mp4
assets/nuevo/*.jpg
assets/nuevo/_clips.json
